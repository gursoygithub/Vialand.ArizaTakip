# Normalize all text files to LF line endings on checkout, regardless of the
# committer's or checker-out's core.autocrlf setting. This prevents CRLF from
# breaking shell scripts and .env parsing inside Docker/Sail (Linux) containers.
* text=auto eol=lf

# Shell scripts and env files must always be LF — a CRLF shebang or a `\r` in
# .env breaks bash when Sail/Docker sources them.
*.sh text eol=lf
.env text eol=lf
.env.* text eol=lf
install.sh text eol=lf
start-container text eol=lf

# Windows-only scripts, if any are ever added, keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Common binary types — never touch line endings in these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
